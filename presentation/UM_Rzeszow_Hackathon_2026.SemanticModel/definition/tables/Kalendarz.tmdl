	partition Kalendarz = calculated
		mode: import
		source =
				
				VAR DataPoczatkowa = DATE(2025, 1, 1)
				VAR DataKoncowa = DATE(2026, 06, 30)
				RETURN
				ADDCOLUMNS(
				    CALENDAR(DataPoczatkowa, DataKoncowa),
				    "Rok", YEAR([Date]),
				    "MiesiacNr", MONTH([Date]),
				    "Miesiac", FORMAT([Date], "MMMM"),
				    "RokMiesiac", FORMAT([Date], "YYYYMM"),
				    "Kwartal", "Q" & FORMAT([Date], "Q"),
				    "Dzien", DAY([Date]),
				    "DzienTygodniaNr", WEEKDAY([Date], 2),
				    "DzienTygodnia", FORMAT([Date], "dddd")
				)

	annotation PBI_Id = 20ec9c0863234040a39e13a265be7e27

