	partition Imprezy = m
		mode: import
		source =
				let
				    Źródło = Excel.Workbook(File.Contents("C:\Users\JO\Desktop\Hackathon\Imprezy sportowe.xlsx"), null, true),
				    Imprezy_Sheet = Źródło{[Item="Imprezy",Kind="Sheet"]}[Data],
				    #"Nagłówki o podwyższonym poziomie" = Table.PromoteHeaders(Imprezy_Sheet, [PromoteAllScalars=true]),
				    #"Zmieniono typ" = Table.TransformColumnTypes(#"Nagłówki o podwyższonym poziomie",{{"WYDARZENIE", type text}, {"Impreza_start", type date}, {"Impreza_koniec", type date}})
				in
				    #"Zmieniono typ"

	annotation PBI_ResultType = Table

