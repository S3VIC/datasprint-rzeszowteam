table Imprezy
	lineageTag: 2f0160c8-9e65-4a7d-9c5f-94dfcfe93616

	measure 'Wartość_transakcji EVENT' =
			
			VAR EventStart =
			    SELECTEDVALUE('Imprezy'[impreza_start])
			
			VAR EventEnd =
			    SELECTEDVALUE('Imprezy'[impreza_koniec])
			
			RETURN
			IF(
			    ISBLANK(EventStart) || ISBLANK(EventEnd),
			    BLANK(),
			    CALCULATE(
			        SUM('dane_hackathon'[cs_tran_amt]),
			        REMOVEFILTERS('Kalendarz'),
			        DATESBETWEEN(
			            'Kalendarz'[Date],
			            EventStart,
			            EventEnd
			        )
			    )
			)
		formatString: #,0.###############\ "zł";-#,0.###############\ "zł";#,0.###############\ "zł"
		lineageTag: 8834ffe3-31f8-41be-9f63-f5c6f7bf7b35

		annotation PBI_FormatHint = {"currencyCulture":"pl-PL"}

	measure 'Średnia PRZED wartość transakcji' =
			
			VAR EventStart =
			    SELECTEDVALUE('Imprezy'[impreza_start])
			
			VAR EventEnd =
			    SELECTEDVALUE('Imprezy'[impreza_koniec])
			
			VAR Okres1 =
			    CALCULATE(
			        Sum('dane_hackathon'[cs_tran_amt]),
			        REMOVEFILTERS('Kalendarz'),
			        DATESBETWEEN(
			            'Kalendarz'[Date],
			            EventStart - 7,
			            EventEnd - 7
			        )
			    )
			
			VAR Okres2 =
			    CALCULATE(
			        Sum('dane_hackathon'[cs_tran_amt]),
			        REMOVEFILTERS('Kalendarz'),
			        DATESBETWEEN(
			            'Kalendarz'[Date],
			            EventStart - 14,
			            EventEnd - 14
			        )
			    )
			
			VAR Okres3 =
			    CALCULATE(
			        Sum('dane_hackathon'[cs_tran_amt]),
			        REMOVEFILTERS('Kalendarz'),
			        DATESBETWEEN(
			            'Kalendarz'[Date],
			            EventStart - 21,
			            EventEnd - 21
			        )
			    )
			
			RETURN
			IF(
			    ISBLANK(EventStart) || ISBLANK(EventEnd),
			    BLANK(),
			    DIVIDE(
			        Okres1 + Okres2 + Okres3,
			        3
			    )
			)
		formatString: #,0.###############\ "zł";-#,0.###############\ "zł";#,0.###############\ "zł"
		lineageTag: eeaa5fbe-a452-4f8e-8acc-ae88317caacc

		annotation PBI_FormatHint = {"currencyCulture":"pl-PL"}

	measure 'Średnia PO wartość transakcji' =
			
			VAR EventStart =
			    SELECTEDVALUE('Imprezy'[impreza_start])
			
			VAR EventEnd =
			    SELECTEDVALUE('Imprezy'[impreza_koniec])
			
			VAR Okres1 =
			    CALCULATE(
			        Sum('dane_hackathon'[cs_tran_amt]),
			        REMOVEFILTERS('Kalendarz'),
			        DATESBETWEEN(
			            'Kalendarz'[Date],
			            EventStart + 7,
			            EventEnd + 7
			        )
			    )
			
			VAR Okres2 =
			    CALCULATE(
			        Sum('dane_hackathon'[cs_tran_amt]),
			        REMOVEFILTERS('Kalendarz'),
			        DATESBETWEEN(
			            'Kalendarz'[Date],
			            EventStart + 14,
			            EventEnd + 14
			        )
			    )
			
			VAR Okres3 =
			    CALCULATE(
			        Sum('dane_hackathon'[cs_tran_amt]),
			        REMOVEFILTERS('Kalendarz'),
			        DATESBETWEEN(
			            'Kalendarz'[Date],
			            EventStart + 21,
			            EventEnd + 21
			        )
			    )
			
			RETURN
			IF(
			    ISBLANK(EventStart) || ISBLANK(EventEnd),
			    BLANK(),
			    DIVIDE(
			        Okres1 + Okres2 + Okres3,
			        3
			    )
			)
		formatString: #,0.###############\ "zł";-#,0.###############\ "zł";#,0.###############\ "zł"
		lineageTag: 603e75ea-2d01-462e-ae32-459ab222244b

		annotation PBI_FormatHint = {"currencyCulture":"pl-PL"}

